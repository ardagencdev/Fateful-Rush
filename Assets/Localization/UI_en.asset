  - m_Id: 58562746953748
    m_Localized: Fate Is Closing In
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953749
    m_Localized: The Stars Have Gone Silent
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953750
    m_Localized: Every Second Seals Your Path
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953751
    m_Localized: No Signal Reaches Home
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953752
    m_Localized: Something Is Following You
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953753
    m_Localized: The Future Is Collapsing
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953754
    m_Localized: Time Refuses To Wait
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953755
    m_Localized: Your Next Move Is Final
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953756
    m_Localized: The Dark Remembers Your Name
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953757
    m_Localized: Survival Was Never Promised
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953758
    m_Localized: There Is No Safe Vector
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953759
    m_Localized: The End Is Gaining Ground
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953760
    m_Localized: Run Before Fate Finds You
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953761
    m_Localized: Fate Moves Faster Than You
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953762
    m_Localized: The Countdown Has Begun
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953763
    m_Localized: Only Motion Keeps You Alive
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953764
    m_Localized: SIGNAL LOST
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953765
    m_Localized: 'THREAT: UNKNOWN'
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953766
    m_Localized: NO RETURN VECTOR
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953767
    m_Localized: STALKER
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953768
    m_Localized: HUNTER
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953769
    m_Localized: BLASTER
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953770
    m_Localized: LASER BULLET
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953771
    m_Localized: LASER WALL
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953772
    m_Localized: BOSS
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953773
    m_Localized: MINI BOSS
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953774
    m_Localized: SPACE BOMB
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953775
    m_Localized: TIME EXPIRED
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953776
    m_Localized: UNKNOWN
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953777
    m_Localized: YOU LET IT GET TOO CLOSE.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953778
    m_Localized: THE STALKER FOUND ITS OPENING.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953779
    m_Localized: YOU COULDN'T SHAKE IT.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953780
    m_Localized: IT NEVER STOPPED CHASING.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953781
    m_Localized: THE HUNTER CAUGHT ITS PREY.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953782
    m_Localized: YOU COULDN'T OUTRUN THE HUNT.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953783
    m_Localized: THE HUNTER CLOSED THE DISTANCE.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953784
    m_Localized: THERE WAS NOWHERE LEFT TO RUN.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953785
    m_Localized: YOU CROSSED THE BLASTER'S PATH.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953786
    m_Localized: THE BLASTER HAD YOU LINED UP.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953787
    m_Localized: YOU STAYED TOO CLOSE FOR TOO LONG.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953788
    m_Localized: THE BLASTER WON THE STANDOFF.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953789
    m_Localized: ONE SHOT WAS ALL IT TOOK.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953790
    m_Localized: YOU NEVER SAW THAT SHOT COMING.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953791
    m_Localized: THE LASER FOUND ITS MARK.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953792
    m_Localized: ONE HIT ENDED THE RUN.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953793
    m_Localized: THERE WAS NO GAP TO ESCAPE.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953794
    m_Localized: THE LASER WALL CLOSED YOU IN.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953795
    m_Localized: YOU RAN OUT OF ROOM.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953796
    m_Localized: THE WALL LEFT NO WAY THROUGH.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953797
    m_Localized: THE VOID CLAIMED ANOTHER RUN.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953798
    m_Localized: THE BOSS OVERWHELMED YOU.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953799
    m_Localized: YOU COULDN'T SURVIVE ITS ATTACK.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953800
    m_Localized: THE BOSS ENDED YOUR RUN.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953801
    m_Localized: YOU UNDERESTIMATED THE THREAT.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953802
    m_Localized: THE MINI-BOSS CAUGHT YOU OFF GUARD.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953803
    m_Localized: YOU DIDN'T CLEAR THE DANGER ZONE.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953804
    m_Localized: THE THREAT WAS SMALLER. NOT WEAKER.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953805
    m_Localized: YOU WERE CAUGHT IN THE BLAST.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953806
    m_Localized: THE EXPLOSION LEFT NO ESCAPE.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953807
    m_Localized: YOU STAYED TOO CLOSE TO THE BOMB.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953808
    m_Localized: THE BLAST RADIUS GOT YOU.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953809
    m_Localized: TIME RAN OUT.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953810
    m_Localized: YOU NEEDED A FEW MORE SECONDS.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953811
    m_Localized: THE CLOCK WON THIS ROUND.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953812
    m_Localized: YOU RAN OUT OF TIME.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953813
    m_Localized: THE RUN ENDED HERE.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953814
    m_Localized: SOMETHING WENT VERY WRONG.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953815
    m_Localized: THE VOID HAD OTHER PLANS.
    m_Metadata:
      m_Items: []
  - m_Id: 58562746953816
    m_Localized: THIS RUN WASN'T MEANT TO LAST.
    m_Metadata:
      m_Items: []
