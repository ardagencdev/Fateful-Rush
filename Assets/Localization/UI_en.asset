      m_Items: []
  - m_Id: 52008488448060
    m_Localized: CREATED & DEVELOPED BY
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448061
    m_Localized: "ARDA \u2014 YOUNGDEV STUDIOS"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448062
    m_Localized: PLAYTESTING
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448063
    m_Localized: "Recep Eray Gen\xE7\nAybars Duran\nOsman Kerem \u015Eener\nMuhammed
      Sait K\u0131l\u0131\xE7\nBurak Ayd\u0131n\nSoner Pupa\nMustafa Rubaye"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448064
    m_Localized: SPECIAL THANKS
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448065
    m_Localized: "Recep Eray Gen\xE7\nAybars Duran\nOsman Kerem \u015Eener\nMuhammed
      Sait K\u0131l\u0131\xE7\nBurak Ayd\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448066
    m_Localized: "To everyone who played, tested, supported, shared feedback, and
      stayed with this project along the way \u2014 thank you.\n\nFateful Rush was
      built one level, one challenge, and one breakthrough at a time.\n\nReaching
      the end means more than completing 40 missions. It means being part of the
      journey that brought this game to life.\n\nYour time, support, and belief made
      this possible.\n\nThe stars may have gone silent, but the rush lives on."
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448067
    m_Localized: THANK YOU FOR PLAYING
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448068
    m_Localized: "YOUNGDEV STUDIOS \u2014 2026"
    m_Metadata:
      m_Items: []
