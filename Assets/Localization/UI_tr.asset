  - m_Id: 52008488448059
    m_Localized: FATEFUL RUSH
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448060
    m_Localized: "GEL\u0130\u015ET\u0130REN"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448061
    m_Localized: "ARDA \u2014 YOUNGDEV STUDIOS"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448062
    m_Localized: "OYUN TEST\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448063
    m_Localized: "Recep Eray Gen\xE7\nAybars Duran\nOsman Kerem \u015Eener\nMuhammed
      Sait K\u0131l\u0131\xE7\nBurak Ayd\u0131n\nSoner Pupa\nMustafa Rubaye"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448064
    m_Localized: "\xD6ZEL TE\u015EEKK\xDCRLER"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448065
    m_Localized: "Recep Eray Gen\xE7\nAybars Duran\nOsman Kerem \u015Eener\nMuhammed
      Sait K\u0131l\u0131\xE7\nBurak Ayd\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448066
    m_Localized: "Bu oyunu oynayan, test eden, destekleyen, geri bildirim payla\u015Fan
      ve bu proje boyunca yan\u0131mda olan herkese \u2014 te\u015Fekk\xFCr ederim.\n\nFateful
      Rush; her seferinde bir b\xF6l\xFCm, bir zorluk ve bir d\xF6n\xFCm noktas\u0131
      a\u015F\u0131larak geli\u015Ftirildi.\n\nSona ula\u015Fmak, 40 g\xF6revi tamamlamaktan
      daha fazlas\u0131 demek. Bu oyunu hayata ge\xE7iren yolculu\u011Fun bir par\xE7as\u0131
      olmak demek.\n\nAy\u0131rd\u0131\u011F\u0131n\u0131z zaman, deste\u011Finiz
      ve inanc\u0131n\u0131z bunu m\xFCmk\xFCn k\u0131ld\u0131.\n\nY\u0131ld\u0131zlar
      sessizli\u011Fe b\xFCr\xFCnm\xFC\u015F olabilir, ama Rush ya\u015Famaya devam
      ediyor."
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448067
    m_Localized: "OYUNU OYNADI\u011EIN \u0130\xC7\u0130N TE\u015EEKK\xDCRLER"
    m_Metadata:
      m_Items: []
  - m_Id: 52008488448068
    m_Localized: "YOUNGDEV STUDIOS \u2014 2026"
    m_Metadata:
      m_Items: []
